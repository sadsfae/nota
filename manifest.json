{
  "schemaVersion": 1,
  "id": "io.github.sadsfae.nota",
  "name": "Nota",
  "version": "0.4.3",
  "author": "Will Foster",
  "license": "MIT",
  "description": "A simple, floating note-taking widget for the Omarchy top bar, with autosave and a hotkey toggle.",
  "kinds": [
    "bar-widget",
    "overlay"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "NoteWidget.qml",
    "overlay": "NoteEditor.qml"
  },
  "barWidget": {
    "displayName": "Nota",
    "description": "Toggle a floating note",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
